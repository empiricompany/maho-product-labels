includes:
    - vendor/mahocommerce/maho-phpstan-plugin/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    strictRules:
        allRules: false
        matchingInheritedMethodNames: true
        disallowedBacktick: true

    level: 8
    tmpDir: .phpstan.cache
    reportUnmatchedIgnoredErrors: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    checkMissingOverrideMethodAttribute: true
    treatPhpDocTypesAsCertain: false
    reportMaybesInPropertyPhpDocTypes: true
    reportMaybesInMethodSignatures: false

    fileExtensions:
        - php
        - phtml

    paths:
        - app

    excludePaths:
        analyse:
            - vendor/mahocommerce/maho-phpstan-plugin/mock
        analyseAndScan:
            - vendor/mahocommerce/maho-phpstan-plugin/mock

    ignoreErrors:
        -
            identifier: property.missingOverride
            reportUnmatched: false
        -
            identifier: missingType.iterableValue
            paths:
                - app/code/community/MM/ProductLabels/Model/Indexer/Product.php
            reportUnmatched: false
        # The grid overrides leave the parameter untyped on purpose: the released 26.x core
        # declares getRowUrl($row) and _addColumnFilterToCollection($column) without types, where a
        # typed parameter would be a fatal, while on dev-main an untyped parameter is wider and
        # therefore allowed. The return type carries the contract on both lines.
        -
            identifier: missingType.parameter
            paths:
                - app/code/community/MM/ProductLabels/Block/Adminhtml/Rule/Grid.php
                - app/code/community/MM/ProductLabels/Block/Adminhtml/Rule/Edit/Tab/Products/Grid.php
