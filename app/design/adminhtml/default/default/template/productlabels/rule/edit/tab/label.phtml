<script>
(function () {
    'use strict';
    var config = <?= $configJson ?>;
    var layout = document.querySelector('.pl-layout');
    var storeSelect = document.getElementById('pl-preview-store');
    var badge = document.getElementById('pl-badge');
    var badgeText = document.getElementById('pl-badge-text');
    var badgeImage = document.getElementById('pl-badge-img');
    var media = document.getElementById('pl-tile-media');
    var body = document.getElementById('pl-tile-body');
    var meta = document.getElementById('pl-preview-meta');
    if (!layout || !badge || !storeSelect) {
        return;
    }

    var currentStore = storeSelect.value;
    var objectUrls = {};

    function getCard(storeId) {
        return layout.querySelector('.pl-card[data-store-id="' + storeId + '"]');
    }

    function getField(id) {
        return document.getElementById('pl_' + id);
    }

    function getImage(card) {
        var file = card.querySelector('input[type="file"]');
        if (file && file.files && file.files.length > 0) {
            var selected = file.files[0];
            var key = card.getAttribute('data-store-id') + '|' + selected.name + '|' + selected.size;
            if (!objectUrls[key]) {
                objectUrls[key] = URL.createObjectURL(selected);
            }
            return objectUrls[key];
        }
        var remove = card.querySelector('input[type="checkbox"]');
        if (remove && remove.checked) {
            return '';
        }
        return card.getAttribute('data-image-url') || '';
    }

    function refreshState(card) {
        var text = card.querySelector('input[type="text"]');
        var state = card.querySelector('[data-pl-state]');
        var filled = (text && text.value.trim() !== '') || getImage(card) !== '';
        card.classList.toggle('is-filled', filled);
        if (state) {
            state.textContent = filled ? config.edited : config.empty;
        }
        return filled;
    }

    function refresh() {
        var card = getCard(currentStore);
        if (!card) {
            return;
        }
        var text = card.querySelector('input[type="text"]');
        var value = text ? text.value : '';
        var image = getImage(card);
        var empty = image === '' && value === '';

        badgeImage.hidden = image === '';
        if (image !== '') {
            badgeImage.src = image;
        }
        badgeText.hidden = image !== '';
        badgeText.textContent = value === '' ? config.placeholder : value;

        var fg = getField('text_color');
        var bg = getField('bg_color');
        var position = getField('position');
        if (image !== '' || empty) {
            // An image label ignores the rule colors, and an empty one shows a placeholder only.
            badge.style.color = image !== '' ? '' : 'var(--maho-ink-muted)';
            badge.style.backgroundColor = 'transparent';
            badge.style.border = image !== '' ? '0' : '1px dashed currentColor';
            badge.style.padding = image !== '' ? '0' : '';
        } else {
            badge.style.color = fg && fg.value ? fg.value : '#ffffff';
            badge.style.backgroundColor = bg && bg.value ? bg.value : '#111827';
            badge.style.border = '0';
            badge.style.padding = '';
        }

        var positionValue = position && position.value ? position.value : 'top-left';
        badge.className = 'pl-badge pl-badge--' + positionValue;
        (positionValue === 'content' ? body : media).appendChild(badge);

        var positionLabel = position && position.selectedIndex >= 0
            ? position.options[position.selectedIndex].text
            : '';
        var colors = [];
        if (image === '' && fg && fg.value) {
            colors.push(config.textColor + ' ' + fg.value);
        }
        if (image === '' && bg && bg.value) {
            colors.push(config.bgColor + ' ' + bg.value);
        }
        meta.textContent = [positionLabel].concat(colors).filter(Boolean).join(' · ')
            + (image !== '' ? ' · ' + config.imageHint : '');

        refreshState(card);
    }

    function focusCard(card) {
        currentStore = card.getAttribute('data-store-id');
        storeSelect.value = currentStore;
        refresh();
    }

    layout.addEventListener('focusin', function (event) {
        var card = event.target.closest('.pl-card');
        if (card) {
            focusCard(card);
        }
    });

    layout.addEventListener('input', function (event) {
        var card = event.target.closest('.pl-card');
        if (card) {
            focusCard(card);
            return;
        }
        refresh();
    });

    layout.addEventListener('change', function (event) {
        var card = event.target.closest('.pl-card');
        if (!card) {
            refresh();
            return;
        }
        var file = card.querySelector('input[type="file"]');
        var remove = card.querySelector('input[type="checkbox"]');
        if (event.target === remove && remove.checked && file) {
            // The stored image is dropped, so a file still sitting in the picker would win on save.
            file.value = '';
        }
        if (event.target === file && file.files && file.files.length > 0 && remove) {
            // An uploaded file replaces the stored image: "remove" stops applying.
            remove.checked = false;
        }
        focusCard(card);
    });

    storeSelect.addEventListener('change', function () {
        currentStore = storeSelect.value;
        refresh();
    });

    var cards = layout.querySelectorAll('.pl-card');
    var filledCard = null;
    Array.prototype.forEach.call(cards, function (card) {
        if (refreshState(card) && !filledCard) {
            filledCard = card;
        }
    });
    if (filledCard) {
        currentStore = filledCard.getAttribute('data-store-id');
        storeSelect.value = currentStore;
    }
    refresh();
})();
</script>
